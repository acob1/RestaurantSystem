    },
    "Update cart item quantity": {
      "main": [[{"node": "Format cart response", "type": "main", "index": 0}]]
    },
    "Remove item from cart": {
      "main": [[{"node": "Format cart response", "type": "main", "index": 0}]]
    },
    "Clear cart": {
      "main": [[{"node": "Format cart response", "type": "main", "index": 0}]]
    },
    "Get current cart": {
      "main": [[{"node": "Format cart response", "type": "main", "index": 0}]]
    },
    "Format cart response": {
      "main": [[{"node": "Return cart result", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 45,
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
