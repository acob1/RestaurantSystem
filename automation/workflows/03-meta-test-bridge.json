      "parameters": {
        "content": "## Meta test bridge — inactive until configured\nOnly the ASP.NET Core signed webhook should feed this authenticated internal endpoint. Replace the test phone ID, allowlisted recipient and supported Graph version before importing. Bind separate Header Auth and Meta Bearer Auth credentials. This calls existing workflow 02 without changing it. It sends only to the one test recipient; no orders or payments.",
        "height": 245,
        "width": 850
      }
    }
  ],
