        "responseBody": "={{ {ok:false,messageId:$json.messageId,error:$json.error,upstreamStatus:$json.upstreamStatus} }}",
        "options": {
          "responseCode": "={{ $json.httpStatus }}",
          "responseHeaders": {
            "entries": [
              {
                "name": "Cache-Control",
                "value": "no-store"
              }
            ]
          }
        }
      }
    },
    {
      "id": "note",
      "name": "Milestone 3 test contract",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 2.1,
      "position": [
        0,
        -500
