# Copy to automation/.env.neon (ignored). Never use business/staging/production DB credentials.
COMPOSE_PROJECT_NAME=restaurant-automation-neon
AUTOMATION_PORT=5678
# Use the DIRECT Neon hostname: n8n runs its own migrations and keeps a pool of 2.
DB_POSTGRESDB_HOST=ep-REPLACE.REGION.aws.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=restaurant_automation_dev
DB_POSTGRESDB_USER=restaurant_automation
DB_POSTGRESDB_PASSWORD=REPLACE
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=true
N8N_ENCRYPTION_KEY=REPLACE_WITH_STABLE_RANDOM_32_BYTE_SECRET
RESTAURANT_WEBHOOK_TOKEN=REPLACE_WITH_RANDOM_WEBHOOK_SECRET
