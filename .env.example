# Copy to .env; never commit filled credentials. Compose uses this automatically.
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=restaurant_dev;Username=restaurant;Password=local-development-only;SSL Mode=Disable"
# Neon: replace the connection above with the Npgsql form below (not a postgres:// URI).
# Host=ep-REPLACE-pooler.REGION.aws.neon.tech;Database=restaurant_business_dev;Username=REPLACE;Password=REPLACE;SSL Mode=VerifyFull;Maximum Pool Size=10
# Use a separate direct (non -pooler) connection for migrations.
Paystack__Mode=Test
Paystack__SecretKey=sk_test_REPLACE
Paystack__PublicKey=pk_test_REPLACE
Payments__AllowLivePayments=false
Cloudinary__CloudName=REPLACE
Cloudinary__ApiKey=REPLACE
Cloudinary__ApiSecret=REPLACE
# Store the Meta Graph access token only in hosted n8n's Bearer Auth credential.
Meta__PhoneNumberId=REPLACE
Meta__VerifyToken=REPLACE
Meta__AppSecret=REPLACE
Meta__TestMode=false
Meta__AllowedTestRecipient=REPLACE_WITH_ONE_VERIFIED_TEST_RECIPIENT_WA_ID
AI__Provider=Groq
AI__ApiKey=REPLACE
AI__Model=REPLACE_WITH_AVAILABLE_MODEL
Automation__BaseUrl=http://localhost:5678
Automation__SharedSecret=REPLACE_WITH_RANDOM_SECRET
Automation__MetaBridgeUrl=https://restaurant-n8n-5i1u.onrender.com/webhook/restaurant-dev/meta-bridge
Automation__MetaBridgeToken=REPLACE_WITH_DISTINCT_RANDOM_SECRET
# Public, non-secret dashboard build setting; empty uses Angular's dev proxy.
PUBLIC_API_BASE_URL=
# n8n uses a separate local container/database, or a separate Neon project/database.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=REPLACE.neon.tech
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=restaurant_automation_dev
DB_POSTGRESDB_USER=REPLACE
DB_POSTGRESDB_PASSWORD=REPLACE
DB_POSTGRESDB_SCHEMA=public
DB_POSTGRESDB_SSL_ENABLED=true
DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true
DB_POSTGRESDB_POOL_SIZE=2
N8N_ENCRYPTION_KEY=REPLACE_WITH_STABLE_RANDOM_32_BYTE_SECRET
WEBHOOK_URL=https://REPLACE.onrender.com/
N8N_EDITOR_BASE_URL=https://REPLACE.onrender.com/
N8N_HOST=REPLACE.onrender.com
N8N_PROTOCOL=https
N8N_PROXY_HOPS=1
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=48
EXECUTIONS_DATA_PRUNE_MAX_COUNT=1000
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=none
