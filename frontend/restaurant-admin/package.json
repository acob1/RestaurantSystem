    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "typescript": "6.0.2",
    "vitest": "4.1.12",
    "jsdom": "27.4.0",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
